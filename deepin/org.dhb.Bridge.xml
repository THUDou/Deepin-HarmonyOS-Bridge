<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN"
 "http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<node>
  <interface name="org.dhb.Bridge">
    <method name="GetStatus">
      <arg name="status" type="a{sv}" direction="out"/>
    </method>

    <method name="ListDevices">
      <arg name="devices" type="aa{sv}" direction="out"/>
    </method>

    <method name="GetReceiveDir">
      <arg name="path" type="s" direction="out"/>
    </method>

    <method name="SetReceiveDir">
      <arg name="path" type="s" direction="in"/>
      <arg name="ok" type="b" direction="out"/>
    </method>

    <method name="Pair">
      <arg name="host" type="s" direction="in"/>
      <arg name="port" type="q" direction="in"/>
      <arg name="psk" type="s" direction="in"/>
      <arg name="ok" type="b" direction="out"/>
    </method>

    <method name="SendFile">
      <arg name="path" type="s" direction="in"/>
      <arg name="ok" type="b" direction="out"/>
    </method>

    <method name="CancelTransfer">
      <arg name="id" type="s" direction="in"/>
      <arg name="ok" type="b" direction="out"/>
    </method>

    <signal name="DeviceFound">
      <arg name="device" type="a{sv}"/>
    </signal>

    <signal name="TransferProgress">
      <arg name="id" type="s"/>
      <arg name="sent" type="t"/>
      <arg name="total" type="t"/>
    </signal>

    <signal name="TransferFinished">
      <arg name="id" type="s"/>
      <arg name="ok" type="b"/>
      <arg name="message" type="s"/>
    </signal>

    <signal name="StatusChanged">
      <arg name="status" type="s"/>
    </signal>
  </interface>
</node>
